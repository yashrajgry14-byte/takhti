{"3bf540bc4a733407":{"t":"Count to five","b":19688},"6d9ba0406e68a0f9":{"t":"The game is starting. Let us count these.","b":38914},"f2ad192454bb56da":{"t":"How many are there now?","b":25539},"89d87d85eb6c9a17":{"t":"Five! You counted every single one.","b":39750},"3a27615d391fc15b":{"t":"Count to ten","b":18016},"dc623bff2c02c805":{"t":"You have ten fingers. Let us find ten of these too.","b":53124},"7994a085d8918f52":{"t":"Ten is the same as how many hands?","b":34316},"87b5e4943cec3e64":{"t":"Two hands, ten fingers, ten of these. Well done!","b":53124},"1b84cd87292d0abb":{"t":"More or fewer","b":18852},"1c02a8066343b970":{"t":"Two teams. One has more than the other — can you see which?","b":58140},"6baec2532115a593":{"t":"Which is more?","b":18852},"138aebc4a80f63d5":{"t":"Five is more than two. Bigger pile, bigger number.","b":58140},"22b8ca5fa1a45eb0":{"t":"Making them equal","b":20942},"080aae25a6b11c72":{"t":"Two friends must get the same. Not more, not less.","b":53960},"a47d485cd7932dea":{"t":"How many did each friend get?","b":30137},"fc67150c83a4baec":{"t":"Two each. That is what fair means.","b":38078},"680db37bc5d2f63e":{"t":"First, second, third","b":24703},"61fc640d1bad8657":{"t":"The race is over! Let us see who finished where.","b":51035},"ef3903fd46581cd7":{"t":"How many finished the race?","b":27211},"f10bcf420c9e0a4a":{"t":"First, second, third. Counting tells you the order.","b":61902},"f57f63d3d8007e7b":{"t":"Adding up to five","b":21777},"9c60fb74fcafc023":{"t":"Three are already here. Watch what happens when friends turn up.","b":62737},"2a2c1a415c106442":{"t":"3 and 2 more makes…","b":24703},"ca54f6fd0057fc39":{"t":"Adding just means putting groups together.","b":38914},"86bd6e3c7eedcc01":{"t":"Adding up to ten","b":20524},"810eaaaf5ba0d2ea":{"t":"A bigger match today. Bigger numbers too.","b":42675},"b1a64648bef7e30b":{"t":"6 and 3 more makes…","b":27211},"34b1f47276d44655":{"t":"You can add without counting from one every time.","b":46437}