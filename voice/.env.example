# Copy to voice/.env and fill in. voice/.env is git-ignored.

# Where Bolna can reach this server (your tunnel or host), no trailing slash
TAKHTI_PUBLIC_URL=https://your-tunnel.trycloudflare.com

# Shared secrets. Any long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TAKHTI_TOOL_TOKEN=
TAKHTI_WEBHOOK_KEY=
TAKHTI_ADMIN_KEY=

# From the Bolna dashboard (Settings → API keys, and your agent's page)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Optional: the number Munni calls from (E.164). Leave empty to use Bolna's default.
BOLNA_FROM_NUMBER=
# 1 if the Bolna agent is set up as multilingual (Hindi + English)
BOLNA_MULTILINGUAL=0

# Optional
PORT=8787
TAKHTI_DATA_DIR=

# Keypad answers. 0 on Exotel or Vobiz numbers (no DTMF there).
TAKHTI_KEYPAD=1

# The inbound line (a child calls Munni)
TAKHTI_INBOUND_DAILY=2
TAKHTI_QUIET_HOURS=21-7
TAKHTI_TZ=Asia/Kolkata

# Talking Munni in the app (Bolna Web Call SDK). Leave empty to switch it off.
# The app's own origin, for CORS, e.g. https://takhti.example.in
TAKHTI_APP_ORIGIN=
# Optional: a separate agent for web talks; falls back to BOLNA_AGENT_ID
BOLNA_WEB_AGENT_ID=
TAKHTI_WEB_DAILY=3
TAKHTI_WEB_PER_HOUR=10
TAKHTI_WEB_GRACE_MS=90000
