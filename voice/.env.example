# Copy to voice/.env and fill in. voice/.env is git-ignored.

# Where Bolna can reach this server (your tunnel or host), no trailing slash
TAKHTI_PUBLIC_URL=https://your-tunnel.trycloudflare.com

# Shared secrets. Any long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TAKHTI_TOOL_TOKEN=
TAKHTI_WEBHOOK_KEY=
TAKHTI_ADMIN_KEY=

# From the Bolna dashboard (Settings → API keys, and your agent's page)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Optional: the number Munni calls from (E.164). Leave empty to use Bolna's default.
BOLNA_FROM_NUMBER=
# 1 if the Bolna agent is set up as multilingual (Hindi + English)
BOLNA_MULTILINGUAL=0

# Optional
PORT=8787
TAKHTI_DATA_DIR=
