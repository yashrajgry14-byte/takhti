# Copy to voice/.env and fill in. voice/.env is git-ignored.

# Where Bolna can reach this server (your tunnel or host), no trailing slash
TAKHTI_PUBLIC_URL=https://your-tunnel.trycloudflare.com

# Shared secrets. Any long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TAKHTI_TOOL_TOKEN=
TAKHTI_WEBHOOK_KEY=
TAKHTI_ADMIN_KEY=

# From the Bolna dashboard (Settings → API keys, and your agent's page)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Optional: the number Munni calls from (E.164). Leave empty to use Bolna's default.
BOLNA_FROM_NUMBER=
# 1 if the Bolna agent is set up as multilingual (Hindi + English)
BOLNA_MULTILINGUAL=0

# Optional
PORT=8787
TAKHTI_DATA_DIR=

# Keypad answers. 0 on Exotel or Vobiz numbers (no DTMF there).
TAKHTI_KEYPAD=1

# The inbound line (a child calls Munni)
TAKHTI_INBOUND_DAILY=2
TAKHTI_QUIET_HOURS=21-7
TAKHTI_TZ=Asia/Kolkata

# Talking Munni in the app (Bolna Web Call SDK). Leave empty to switch it off.
# The app's own origin, for CORS, e.g. https://takhti.example.in
TAKHTI_APP_ORIGIN=
# Optional: a separate agent for web talks; falls back to BOLNA_AGENT_ID
BOLNA_WEB_AGENT_ID=
TAKHTI_WEB_DAILY=3
TAKHTI_WEB_PER_HOUR=10
TAKHTI_WEB_GRACE_MS=90000

# Parent calls: the consent call and the weekly progress call
# (agent from voice/agent/build-parent-agent.js)
BOLNA_PARENT_AGENT_ID=
# Said to parents as the way to stop or delete everything, e.g. a school phone number
TAKHTI_HELP_CONTACT=

# WhatsApp + call sequences (Bolna Workflows, from voice/agent/build-workflow.js)
BOLNA_DAILY_WORKFLOW_ID=
BOLNA_CONSENT_WORKFLOW_ID=
TAKHTI_WA_CARD=takhti_card
TAKHTI_WA_REPORT=takhti_report
TAKHTI_WA_MISSED=takhti_missed
TAKHTI_WA_CONSENT=takhti_consent
TAKHTI_CARD_LEAD_MIN=20
# The scheduler (lesson days, one retry, weekly calls). 0 turns it off.
TAKHTI_SCHEDULER=1
TAKHTI_RETRY_MINUTES=30
TAKHTI_FIRE_WINDOW_MIN=60

# Misreading corpus: a heard form is shown only once this many different
# children produced it (only children whose parents said yes to improving Takhti)
TAKHTI_CORPUS_MIN_CHILDREN=3

# Talking Munni in the games: at most one line from Munni every this many ms,
# and at most this many game lines per talk
TAKHTI_PLAY_GAP_MS=6000
TAKHTI_PLAY_MAX=25

# The learning circle (voice/circle.js, voice/messages.js)
# WhatsApp to grown-ups through an AiSensy API campaign (two parameters: text, link).
# Without a key, messages wait on the dashboard as one-tap wa.me links.
AISENSY_API_KEY=
AISENSY_CAMPAIGN=takhti_circle
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2
# at most this many circle messages a day to one person
TAKHTI_MSG_DAILY=3
# weekdays (1 = Monday … 7 = Sunday) on which the Friday check is open
TAKHTI_CHECK_DAYS=5,6,7
# app syncs per hour from one address
TAKHTI_SYNC_PER_HOUR=120
# minutes after midnight when the evening circle messages may go (17:00)
TAKHTI_CIRCLE_EVENING_MIN=1020

# Ask Munni: "still stuck? Munni calls" (voice/help.js) — help calls per child per day,
# separate from Talking Munni's TAKHTI_WEB_DAILY
TAKHTI_HELP_DAILY=6

# The shared mistakes database (voice/mistakes.js): a combination of mistakes the
# children's twins worked out becomes known in every app once this many children share it
TAKHTI_MISTAKE_MIN_CHILDREN=3
# (optional) the key for counting children by a hash of their id; defaults to the admin key
TAKHTI_MISTAKE_SALT=

# ---- Speech: the reading check, Teach Munni's hearing, Munni's voice (voice/speech.js) ----
# Under the reading terms a parent accepts (v3). One line or one explanation is written
# down and sent back; nothing is kept.
# gemini (default since 12 Nov 2026) or sarvam. Gemini falls back to Sarvam when Sarvam
# is set up; sarvam uses Sarvam only. Switch to sarvam if the day-1 comparison
# (tools/compare-speech.mjs) shows Gemini mishearing children reading Hindi.
SPEECH_PROVIDER=gemini
# Gemini hears with GEMINI_SPEECH_MODEL and speaks with GEMINI_TTS_MODEL (Google's
# speech-generation guide, Nov 2026). Use the paid tier: Google doesn't train on it.
# GEMINI_SPEECH_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore
# the whole budget for one reading check, both providers together (under the phone's 10 s)
# TAKHTI_SPEECH_BUDGET_MS=9000
# GEMINI_SPEECH_TIMEOUT_MS=6000

# The backup: Sarvam (voice/asr.js) — it also speaks a line the offline pack lacks, live.
SARVAM_API_KEY=
# saaras:v3 in "verbatim" mode writes down what was said, not a tidied sentence
SARVAM_STT_MODEL=saaras:v3
# or any OpenAI-compatible transcription endpoint
WHISPER_API_KEY=
WHISPER_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_MODEL=whisper-1
# sarvam | whisper (otherwise: whichever has a key)
TAKHTI_ASR_PROVIDER=
TAKHTI_ASR_PER_HOUR=120
TAKHTI_ASR_TIMEOUT_MS=8000
# Munni's voice for "say it with Munni" (POST /reading/tts) — use the same voice as tools/build-audio.mjs
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_SPEAKER=anushka

# ---- The school's syllabus → next week's lessons (POST /syllabus, api/syllabus.mjs) ----
# A teacher uploads a chapter in the teacher view; Gemini drafts lessons in
# Takhti's format; the phone checks every one and the teacher approves.
# The same key is used for speech (above) and Teach Munni's judge.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# when that one is busy (503) or unknown (404); 'none' to switch off
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# biggest chapter PDF, in MB (the voice server's default is 12)
# TAKHTI_SYLLABUS_MAX_MB=12
# Teach Munni's judge (POST /teach/judge) uses the same Gemini key; its limit per address per hour:
# TAKHTI_TEACH_PER_HOUR=120
# a school password the teacher view must send (optional, recommended in production)
# TAKHTI_SYLLABUS_KEY=
# TAKHTI_SYLLABUS_PER_HOUR=20
